# =============================================
# UBI - Environment Variables Example / Template
# =============================================
# Copy this file to .env.dev or .env.prod and fill in your actual values.

# ── MySQL Database ──
MYSQL_ROOT_PASSWORD=your_mysql_password
MYSQL_DATABASE=ceipa_chatbot
MYSQL_PORT=3307

# ── ChromaDB Vector Store ──
CHROMA_HOST=ubi-chromadb
CHROMA_PORT=8000

# ── PHP / Database Connection ──
DB_HOST=ubi-mysql
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=ceipa_chatbot
DB_PORT=3306

# ── Python / OpenAI ──
OPENAI_API_KEY=sk-your-openai-api-key-here
# Modelo de chat (Catedrático IA) y de embeddings. Cambiar el de embeddings
# obliga a re-vectorizar las colecciones existentes.
OPENAI_MODEL=gpt-5.1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_TEMPERATURE=0

# ── Mail Service ──
MAIL_HOST=smtp.office365.com
MAIL_USER=asistente_virtual@ceipa.edu.co
MAIL_PASSWORD=your_mail_password

# ── App Environment (development | production) ──
APP_ENV=development

# ── Shared Paths (inside Docker containers) ──
UPLOAD_PATH=/var/www/shared/files
IMAGE_PATH=/var/www/shared/images
PDF_STORAGE_PATH=/var/www/shared/pdf_questions
HISTORY_STORAGE_PATH=/var/www/shared/chat_history

# ── JWT Keys (RSA) ──
# Las llaves NO van en el código ni en el repo. Se generan como archivos PEM y se
# montan (read-only) FUERA del document root. Genera un par con:
#   openssl genrsa -out api_php/keys/jwt_private.pem 2048
#   openssl rsa -in api_php/keys/jwt_private.pem -pubout -out api_php/keys/jwt_public.pem
JWT_PRIVATE_KEY_FILE=/var/www/keys/jwt_private.pem
JWT_PUBLIC_KEY_FILE=/var/www/keys/jwt_public.pem

# ── URL pública del sitio (enlaces absolutos en emails) ──
# Dev: http://localhost:3011  |  Prod: https://tu-dominio
APP_PUBLIC_URL=https://ubi.ceipa.edu.co

# ── Uvicorn (backend Python, solo prod) ──
# Nº de workers. Vacío/comentado => el entrypoint lo deriva de las CPU: (2*nproc)+1.
# Fija un valor si el host tiene poca RAM (cada worker carga las librerías).
# UVICORN_WORKERS=4
# UVICORN_LOG_LEVEL=info
