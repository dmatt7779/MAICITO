Options +FollowSymLinks
RewriteEngine On

#CORS: reflejar el Origin SOLO si pertenece a ceipa.edu.co (misma política que el
#backend Python). En el stack Docker el admin es same-origin (via proxy Nginx/Vite),
#así que normalmente no se emiten estas cabeceras; se quita el "*" (inseguro y
#además inválido junto con Allow-Credentials).
SetEnvIf Origin "^https?://([a-z0-9.-]+\.)?ceipa\.edu\.co$" UBI_CORS=$0
Header always set Access-Control-Allow-Origin "%{UBI_CORS}e" env=UBI_CORS
Header always set Access-Control-Allow-Methods "GET, POST, OPTIONS" env=UBI_CORS
Header always set Access-Control-Allow-Headers "Content-Type, Authorization" env=UBI_CORS
Header always set Vary "Origin"

#Verify That The Authorization Header Is Enabled And Is Not Empty.
RewriteCond %{HTTP:Authorization} .+
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

#Hide Extensions.
#RewriteCond %{REQUEST_FILENAME} !-d
#RewriteCond %{REQUEST_FILENAME}.php -f
#RewriteRule ^([^\.]+)$ $1.php [NC,L]
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^([^/]+)/?$ $1.php [QSA,NC,L]

#Pass Get Parameters GET.
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ - [L]

#Allow OPTIONS requests and respond with 200 OK.
    RewriteCond %{REQUEST_METHOD} OPTIONS
    RewriteRule ^(.*)$ $1 [R=200,L]

#Disabled Directory Browsing.
    Options All -Indexes

